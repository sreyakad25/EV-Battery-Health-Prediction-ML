rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 1. User Profile Photos:
    // Upload path: profile_photos/{userId}.jpg
    // - Reading is permitted so user photos can be displayed across web and mobile.
    // - Writing, updating, and deleting is strictly restricted to the authenticated user whose UID matches.
    match /profile_photos/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Also support timestamped/sub-path versions under the user's UID: profile_photos/{userId}/{allPaths=**}
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Default fallback rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
